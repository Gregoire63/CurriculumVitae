-        name: r.name,
-        n: 0,
-        days: [],
-        keeps,
-        fresh: freshItemsOf(r, lib),
-        bestFresh: !r.batch,
-        frozen,
-      }
-      cur.n += 1
-      cur.days.push(dow)
-      bucket.set(key, cur)
-      buckets.set(where, bucket)
-    }
-  })
