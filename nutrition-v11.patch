-  const mains = dishes.filter(d => MAIN_KINDS.includes(lib.recipes[d.recipeId]?.kind ?? 'boite'))
-  const linesOf = (m: Map<string, number>) =>
-    [...m.entries()]
-      .sort((a, b) => b[1] - a[1])
-      .map(([id, g]) => (lib.foods[id] ? cookLine(lib.foods[id], g) : ''))
-      .filter(Boolean)
